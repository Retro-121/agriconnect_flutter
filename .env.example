# API Keys Configuration Template
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env file with real keys to version control!

# Groq API Key (for AI chat features)
# Get from: https://console.groq.com/keys
GROQ_KEY=your_groq_api_key_here

# Google Gemini API Key (for AI image and text generation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key_here

# OpenWeather API Key (for weather features)
# Get from: https://openweathermap.org/api
OPENWEATHER_KEY=your_openweather_api_key_here
